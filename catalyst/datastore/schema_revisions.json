{
  "table_name": "PartRevisions",
  "description": "Immutable engineering revisions for Part Master records",
  "columns": [
    { "column_name": "tenant_id", "data_type": "Var Char", "max_length": 64, "is_mandatory": true },
    { "column_name": "part_id", "data_type": "Bigint", "is_mandatory": true },
    { "column_name": "revision", "data_type": "Var Char", "max_length": 16, "is_mandatory": true },
    { "column_name": "lifecycle_state", "data_type": "Var Char", "max_length": 32, "is_mandatory": true },
    { "column_name": "change_order_id", "data_type": "Bigint", "is_mandatory": false },
    { "column_name": "released_at", "data_type": "Date Time", "is_mandatory": false },
    { "column_name": "released_by", "data_type": "Var Char", "max_length": 128, "is_mandatory": false },
    { "column_name": "is_baseline_locked", "data_type": "Boolean", "is_mandatory": true, "default_value": false },
    { "column_name": "revision_notes", "data_type": "Var Char", "max_length": 2000, "is_mandatory": false }
  ]
}
