    { "column_name": "name", "data_type": "Var Char", "max_length": 255, "is_mandatory": true },
    { "column_name": "description", "data_type": "Var Char", "max_length": 1000, "is_mandatory": false },
    { "column_name": "part_type", "data_type": "Var Char", "max_length": 32, "is_mandatory": true },
