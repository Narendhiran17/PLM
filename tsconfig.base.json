{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@universal-plm/domain-core": ["./packages/domain-core/dist/index.d.ts"],
      "@universal-plm/authorization": ["./packages/authorization/dist/index.d.ts"]
    }
  }
}
